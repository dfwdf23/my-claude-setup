# 이 파일을 .env 로 복사해 채우세요. (관제실의 설정 화면에서 입력해도 됩니다)
# 키가 없는 분야는 이 컴퓨터의 대체 엔진으로 채워집니다.

# 두뇌 — 리서치·기획·대본·연출·검수·학습
ANTHROPIC_API_KEY=

# 성우·배경음악
ELEVENLABS_API_KEY=

# 이미지·영상 생성 (여러 모델을 키 하나로)
FAL_KEY=

# 예비 (이미지·음성)
OPENAI_API_KEY=

# 리서치 때 조회수 10만 이상 벤치마크 영상 조회 (선택)
YOUTUBE_API_KEY=

# 유튜브 업로드·성과 조회 — 입력 후 설정 화면에서 'YouTube 계정 연결'
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# 인스타그램 릴스 업로드
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# INSTAGRAM_LOGIN_TYPE=facebook      # facebook(기본, 파일 직접 업로드) | instagram(공개 주소 필요)
# PUBLIC_BASE_URL=https://studio.example.com

# 서버
# PORT=4400
# HOST=127.0.0.1                     # 외부에 열려면 0.0.0.0 + 아래 비밀번호 필수
# STUDIO_TOKEN=
# CHROMIUM_PATH=/path/to/chrome      # 브라우저를 자동으로 못 찾을 때만
