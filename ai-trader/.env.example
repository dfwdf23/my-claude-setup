# 이 파일을 .env 로 복사해 값을 채우세요. .env 는 git 에 올라가지 않습니다.
# 연습 모드(sim)와 주문 보조 모드(manual)는 아무 키 없이도 동작합니다.
# 값 뒤에 설명을 붙이지 말고, 설명은 이렇게 따로 줄을 써 주세요.

# --- Claude (시장분석·소식 분류·복기). 없으면 규칙 기반으로만 동작합니다 ---
ANTHROPIC_API_KEY=

# --- 텔레그램 알림(주문 제안·경고·하루 마감 요약). 없으면 알림 없이 동작합니다 ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 대시보드 보호. 다른 기기에서 접속하게 열 때는 반드시 설정(길고 추측하기 어려운 값) ---
DASHBOARD_TOKEN=

# --- 한국투자증권 Open API — 자동 주문(kis-mock / kis-live)에만 필요 ---
# https://apiportal.koreainvestment.com 에서 발급. 모의투자는 모의투자용, 실전은 실전용 앱키·계좌를 넣습니다.
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 앞 8자리
KIS_ACCOUNT=
# 계좌번호 뒤 2자리
KIS_PRODUCT=01
# HTS 로그인 ID — 실시간 체결통보용. 국내 주식은 필수, 해외는 없으면 조회로 대신 확인합니다
KIS_HTS_ID=

# --- 실전 매매 확인(실제 돈이 움직입니다). 모의투자로 충분히 검증한 뒤에만 아래 줄의 # 을 지우세요 ---
# AITRADER_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY
