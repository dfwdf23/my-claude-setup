# 이 파일을 .env 로 복사해 값을 채우세요. .env 는 git 에 올라가지 않습니다.

# --- 한국투자증권 Open API (https://apiportal.koreainvestment.com 에서 발급) ---
# 모의투자(kis-mock)는 모의투자용 앱키/계좌, 실전(kis-live)은 실전용 앱키/계좌를 넣습니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=            # 계좌번호 앞 8자리
KIS_PRODUCT=01          # 계좌번호 뒤 2자리
KIS_HTS_ID=             # HTS 로그인 ID (실시간 체결통보 수신에 필요)

# --- Claude (시장분석·복기). 없으면 규칙 기반으로만 동작합니다 ---
ANTHROPIC_API_KEY=

# --- 대시보드 제어 보호. 외부에서 접속하게 열 때는 반드시 설정 ---
DASHBOARD_TOKEN=

# --- 실전 매매 확인(실제 돈이 움직입니다). 모의투자 검증 후에만 설정 ---
# AITRADER_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY
